{% extends 'app/base.html.twig' %}

{% block body %}
    {% set lockerUrl = '/api/lockers/' ~ locker.code %}
    <div {{ stimulus_controller('locker', {
        url: lockerUrl,
        mercureUrl: mercure(lockerUrl, { subscribe: [lockerUrl] }),
    }) }}>
        <h1>{{ locker.name }}</h1>

        <div class="my-5">
            Le casier est actuellement <strong data-locker-target="state">{{ locker.state|trans }}</strong>
        </div>

        <div class="text-center" data-locker-target="actions">
            {% for transition in finite_reachable_transitions(locker) %}
                <button type="button" class="btn btn-lg btn-primary" data-action="locker#apply" data-transition="{{ transition.name }}">
                    {{ transition.getPropertyValue('label') }}
                </button>
            {% endfor %}
        </div>

        <div class="alert alert-warning mt-4 d-none" role="alert" data-locker-target="error"></div>
    </div>
{% endblock %}
